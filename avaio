img src=\"76dc805b-c814-4cb1-930a-097c7936b94a\" alt=\"AVAIO brand render — apparel\">\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<!-- FOOTER CTA -->\n<div class=\"footer-cta reveal\">\n  <span class=\"footer-label\">Work with Aurient<\u002Fspan>\n  <h2 class=\"footer-title\">Ready to build a brand<br>that <em>earns its place<\u002Fem>?<\u002Fh2>\n  <a href=\"https://www.aurientconsulting.com/#contact\" class=\"cta-btn\">Start a conversation<\u002Fa>\n<\u002Fdiv>\n\n<!-- DIRECTION TOGGLE -->\n<div class=\"dir-toggle\" id=\"dirToggle\">\n  <button class=\"dir-btn active\" id=\"btnDark\" onclick=\"setDir('dark')\">Dark<\u002Fbutton>\n  <button class=\"dir-btn\" id=\"btnLight\" onclick=\"setDir('light')\">Light<\u002Fbutton>\n<\u002Fdiv>\n\n<script>\n  // ── Direction toggle ───────────────────────\n  function setDir(dir) {\n    document.body.className = dir;\n    document.getElementById('btnDark').classList.toggle('active', dir === 'dark');\n    document.getElementById('btnLight').classList.toggle('active', dir === 'light');\n    // Swap logo: gold/white on dark, gold/purple on light\n    const logo = document.getElementById('avaioLogoHero');\n    if (logo) logo.src = dir === 'dark' ? (window.__resources?.logoWhite || 'uploads/AVAIO_gold white.png') : (window.__resources?.logoPurple || 'uploads/AVAIO_gold purple.png');\n    localStorage.setItem('avaio-dir', dir);\n  }\n  // Restore from localStorage\n  const saved = localStorage.getItem('avaio-dir');\n  if (saved) setDir(saved);\n\n  // ── Scroll reveal ──────────────────────────\n  const revealEls = document.querySelectorAll('.reveal, .phase-item, .result-block');\n  const io = new IntersectionObserver((entries) => {\n    entries.forEach((e, i) => {\n      if (e.isIntersecting) {\n        const el = e.target;\n        const siblings = [...el.parentElement.children].filter(c => c === el || c.classList.contains(el.classList[0]));\n        const idx = siblings.indexOf(el);\n        setTimeout(() => el.classList.add('visible'), idx * 80);\n        io.unobserve(el);\n      }\n    });\n  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });\n\n  revealEls.forEach(el => io.observe(el));\n\n  // ── Tweaks protocol ────────────────────────\n  const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{\"direction\":\"dark\"}/*EDITMODE-END*/;\n\n  window.addEventListener('message', (e) => {\n    if (e.data?.type === '__activate_edit_mode') {\n      document.getElementById('dirToggle').style.display = 'flex';\n    }\n    if (e.data?.type === '__deactivate_edit_mode') {\n      document.getElementById('dirToggle').style.display = 'none';\n    }\n  });\n  window.parent.postMessage({ type: '__edit_mode_available' }, '*');\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"

#0D0A14;\n    --bg-alt:       #100D1A;\n    --bg-section:   #0A0810;\n    --surface:      rgba(255,255,255,0.04);\n    --border:       rgba(255,255,255,0.08);\n    --text-primary: #F0EBE3;\n    --text-secondary: rgba(240,235,227,0.55);\n    --text-label:   rgba(240,235,227,0.35);\n    --accent-purple: #7B5EA7;\n    --accent-gold:   #C9A86C;\n    --accent-gold-dim: rgba(201,168,108,0.15);\n    --tag-bg:       rgba(123,94,167,0.18);\n    --tag-text:     #C4AEDE;\n    --nav-bg:       rgba(13,10,20,0.85);\n    --rule:         rgba(255,255,255,0.07);\n    --hero-text:    #F0EBE3;\n    --phase-num:    rgba(201,168,108,0.25);\n  }\n  /* LIGHT direction */\n  body.light {\n    --bg:           #F5F1EB;\n    --bg-alt:       #EDE9E2;\n    --bg-section:   #FAFAF8;\n    --surface:      rgba(45,27,78,0.04);\n    --border:       rgba(45,27,78,0.1);\n    --text-primary: #1A1020;\n    --text-secondary: rgba(26,16,32,0.55);\n    --text-label:   rgba(26,16,32,0.38);\n    --accent-purple: #2D1B4E;\n    --accent-gold:   #B8944A;\n    --accent-gold-dim: rgba(184,148,74,0.12);\n    --tag-bg:       rgba(45,27,78,0.08);\n    --tag-text:     #4A2E7A;\n    --nav-bg:       rgba(245,241,235,0.9);\n    --rule:         rgba(45,27,78,0.1);\n    --hero-text:    #F0EBE3;\n    --phase-num:    rgba(45,27,78,0.12);\n  }\n\n  body {\n    font-family: 'DM Sans', sans-serif;\n    background-color: var(--bg);\n    color: var(--text-primary);\n    transition: background-color 0.5s ease, color 0.5s ease;\n    -webkit-font-smoothing: antialiased;\n  }\n\n\n\n  /* ── HERO ─────────────────────────────────────── */\n  .hero {\n    position: relative;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 80px 80px 80px;\n    overflow: hidden;\n  }\n  .hero-bg {\n    position: absolute; inset: 0;\n    background: #0D0A14;\n  }\n  .hero-bg img {\n    width: 100%; height: 100%;\n    object-fit: cover;\n    opacity: 0.9;\n  }\n  .hero-overlay {\n    position: absolute; inset: 0;\n    background: linear-gradient(\n      to bottom,\n      rgba(10,8,16,0.3) 0%,\n      rgba(10,8,16,0.1) 40%,\n      rgba(10,8,16,0.7) 75%,\n      rgba(10,8,16,0.95) 100%\n    );\n  }\n  body.light .hero-overlay {\n    background: linear-gradient(\n      to bottom,\n      rgba(10,8,16,0.4) 0%,\n      rgba(10,8,16,0.2) 40%,\n      rgba(10,8,16,0.75) 75%,\n      rgba(10,8,16,0.95) 100%\n    );\n  }\n  .hero-content { position: relative; z-index: 2; max-width: 900px; }\n  .hero-eyebrow {\n    display: flex; align-items: center; gap: 12px;\n    margin-bottom: 32px;\n  }\n  .tag {\n    display: inline-block;\n    padding: 5px 12px;\n    border: 1px solid rgba(201,168,108,0.35);\n    border-radius: 2px;\n    font-size: 11px;\n    font-weight: 400;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--accent-gold);\n    background: rgba(201,168,108,0.08);\n  }\n  .hero-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(52px, 7vw, 96px);\n    font-weight: 300;\n    line-height: 1.02;\n    color: #F0EBE3;\n    letter-spacing: -0.01em;\n    margin-bottom: 24px;\n  }\n  .hero-title em {\n    font-style: italic;\n    color: var(--accent-gold);\n  }\n  .hero-subtitle {\n    font-size: 17px;\n    font-weight: 300;\n    line-height: 1.65;\n    color: rgba(240,235,227,0.65);\n    max-width: 580px;\n  }\n  /* Scroll cue */\n  .hero-scroll {\n    position: absolute; bottom: 40px; right: 80px; z-index: 2;\n    display: flex; flex-direction: column; align-items: center; gap: 8px;\n  }\n  .hero-scroll span {\n    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;\n    color: rgba(240,235,227,0.35); writing-mode: vertical-rl;\n  }\n  .scroll-line {\n    width: 1px; height: 48px;\n    background: linear-gradient(to bottom, rgba(201,168,108,0.6), transparent);\n    animation: scrollPulse 2.2s ease-in-out infinite;\n  }\n  @keyframes scrollPulse {\n    0%, 100% { opacity: 0.4; transform: scaleY(1); }\n    50% { opacity: 1; transform: scaleY(1.1); }\n  }\n\n  /* ── PROJECT META BAR ───────────────────────── */\n  .meta-bar {\n    padding: 0 80px;\n    border-bottom: 1px solid var(--rule);\n    transition: border-color 0.5s ease;\n  }\n  .meta-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 0;\n    max-width: 1160px;\n    margin: 0 auto;\n  }\n  .meta-item {\n    padding: 36px 0;\n    border-right: 1px solid var(--rule);\n    padding-right: 32px;\n    transition: border-color 0.5s ease;\n  }\n  .meta-item:last-child { border-right: none; padding-right: 0; }\n  .meta-item + .meta-item { padding-left: 32px; }\n  .meta-label {\n    font-size: 10px; font-weight: 400; letter-spacing: 0.14em;\n    text-transform: uppercase; color: var(--text-label);\n    margin-bottom: 8px;\n    transition: color 0.5s;\n  }\n  .meta-value {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20px; font-weight: 400; line-height: 1.3;\n    color: var(--text-primary);\n    transition: color 0.5s;\n  }\n\n  /* ── SECTIONS ──────────────────────────────── */\n  .section { padding: 100px 80px; }\n  .section-alt { background: var(--bg-alt); transition: background 0.5s; }\n  .section-dark-panel {\n    background: #0D0A14;\n    position: relative; overflow: hidden;\n  }\n  body.light .section-dark-panel { background: #120E1E; }\n\n  .section-inner { max-width: 1160px; margin: 0 auto; }\n\n  .section-label {\n    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;\n    color: var(--accent-gold); margin-bottom: 20px; display: block;\n    font-weight: 400;\n  }\n  .section-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(38px, 4.5vw, 60px);\n    font-weight: 300; line-height: 1.1; letter-spacing: -0.01em;\n    color: var(--text-primary); margin-bottom: 40px;\n    transition: color 0.5s;\n  }\n  .section-title em { font-style: italic; color: var(--accent-gold); }\n  .body-text {\n    font-size: 17px; font-weight: 300; line-height: 1.75;\n    color: var(--text-secondary); max-width: 680px;\n    transition: color 0.5s;\n  }\n  .body-text + .body-text { margin-top: 20px; }\n\n  /* ── TWO COL ──────────────────────────────── */\n  .two-col {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;\n    align-items: start;\n  }\n  .two-col-text { display: flex; flex-direction: column; gap: 24px; }\n\n  /* ── PROBLEM POINTS ─────────────────────────── */\n  .pain-list { list-style: none; margin-top: 32px; display: flex; flex-direction: column; gap: 0; }\n  .pain-item {\n    display: flex; gap: 20px; align-items: flex-start;\n    padding: 20px 0; border-bottom: 1px solid var(--rule);\n    transition: border-color 0.5s;\n  }\n  .pain-item:first-child { border-top: 1px solid var(--rule); }\n  .pain-dash {\n    width: 24px; height: 1px; background: var(--accent-gold);\n    margin-top: 12px; flex-shrink: 0;\n  }\n  .pain-text {\n    font-size: 16px; font-weight: 300; line-height: 1.6;\n    color: var(--text-secondary); transition: color 0.5s;\n  }\n\n  /* ── IMAGE GRID ─────────────────────────────── */\n  .img-full {\n    width: 100%; aspect-ratio: 16/9;\n    overflow: hidden;\n  }\n  .img-full img { transition: transform 0.8s ease; }\n  .img-full:hover img { transform: scale(1.02); }\n\n  .img-half-grid {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;\n  }\n  .img-half { aspect-ratio: 4/3; overflow: hidden; }\n  .img-half img { transition: transform 0.8s ease; }\n  .img-half:hover img { transform: scale(1.03); }\n\n  .img-caption {\n    font-size: 12px; letter-spacing: 0.06em;\n    color: var(--text-label); margin-top: 12px;\n    transition: color 0.5s;\n  }\n\n  /* ── PHASES ──────────────────────────────── */\n  .phases { display: flex; flex-direction: column; gap: 0; margin-top: 48px; }\n  .phase-item {\n    display: grid; grid-template-columns: 80px 1fr;\n    gap: 32px; align-items: start;\n    padding: 40px 0; border-bottom: 1px solid var(--rule);\n    transition: border-color 0.5s;\n    opacity: 0; transform: translateY(24px);\n    transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.5s;\n  }\n  .phase-item.visible { opacity: 1; transform: translateY(0); }\n  .phase-num {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 52px; font-weight: 300; line-height: 1;\n    color: var(--phase-num); transition: color 0.5s;\n    margin-top: 4px;\n  }\n  .phase-body {}\n  .phase-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 28px; font-weight: 400; line-height: 1.2;\n    color: var(--text-primary); margin-bottom: 12px;\n    transition: color 0.5s;\n  }\n  .phase-text {\n    font-size: 16px; font-weight: 300; line-height: 1.7;\n    color: var(--text-secondary); transition: color 0.5s;\n  }\n  .phase-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }\n  .phase-tag {\n    padding: 4px 10px; border: 1px solid var(--border);\n    font-size: 11px; letter-spacing: 0.08em; border-radius: 2px;\n    color: var(--text-label); transition: border-color 0.5s, color 0.5s;\n  }\n\n  /* ── IMAGE + TEXT side by side ──────────────── */\n  .split-section {\n    display: grid; grid-template-columns: 1fr 1fr;\n    gap: 0; align-items: stretch; overflow: hidden;\n  }\n  .split-img { aspect-ratio: auto; min-height: 480px; }\n  .split-text {\n    padding: 80px 64px;\n    display: flex; flex-direction: column; justify-content: center; gap: 24px;\n    background: var(--bg-alt); transition: background 0.5s;\n  }\n\n  /* ── RESULTS ──────────────────────────────── */\n  .results-intro { max-width: 600px; margin-bottom: 64px; }\n  .result-blocks {\n    display: grid; grid-template-columns: repeat(3, 1fr);\n    gap: 2px;\n  }\n  .result-block {\n    background: var(--surface); padding: 48px 40px;\n    border: 1px solid var(--border);\n    transition: background 0.5s, border-color 0.5s;\n    opacity: 0; transform: translateY(20px);\n    transition: opacity 0.6s ease, transform 0.6s ease, background 0.5s, border-color 0.5s;\n  }\n  .result-block.visible { opacity: 1; transform: translateY(0); }\n  .result-number {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 56px; font-weight: 300; line-height: 1;\n    color: var(--accent-gold); margin-bottom: 12px;\n    letter-spacing: -0.02em;\n  }\n  .result-label {\n    font-size: 13px; font-weight: 400; line-height: 1.5;\n    color: var(--text-secondary); transition: color 0.5s;\n  }\n\n  /* ── DARK PANEL (gradient mesh) ──────────────── */\n  .mesh-panel {\n    position: relative; overflow: hidden;\n    padding: 100px 80px;\n  }\n  .mesh-panel-bg {\n    position: absolute; inset: 0;\n  }\n  .mesh-panel-bg img { object-fit: cover; width: 100%; height: 100%; }\n  .mesh-overlay {\n    position: absolute; inset: 0;\n    background: rgba(8,5,15,0.6);\n  }\n  body.light .mesh-overlay { background: rgba(8,5,15,0.55); }\n  .mesh-content { position: relative; z-index: 2; max-width: 780px; }\n  .mesh-quote {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(28px, 3.5vw, 48px);\n    font-weight: 300; font-style: italic;\n    line-height: 1.3; color: #F0EBE3;\n    margin-bottom: 28px;\n  }\n  .mesh-attr {\n    font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase;\n    color: var(--accent-gold);\n  }\n\n  /* ── CLOSING STRIP ──────────────────────────── */\n  .closing-strip {\n    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px;\n  }\n  .closing-img { aspect-ratio: 4/5; overflow: hidden; }\n  .closing-img img { transition: transform 1s ease; }\n  .closing-img:hover img { transform: scale(1.04); }\n\n  /* ── FOOTER CTA ─────────────────────────────── */\n  .footer-cta {\n    padding: 100px 80px;\n    text-align: center;\n    border-top: 1px solid var(--rule);\n    transition: border-color 0.5s;\n  }\n  .footer-label {\n    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;\n    color: var(--text-label); margin-bottom: 24px; display: block;\n  }\n  .footer-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(40px, 5vw, 72px);\n    font-weight: 300; line-height: 1.1; color: var(--text-primary);\n    margin-bottom: 40px; letter-spacing: -0.01em;\n    transition: color 0.5s;\n  }\n  .footer-title em { font-style: italic; color: var(--accent-gold); }\n  .cta-btn {\n    display: inline-block;\n    padding: 16px 40px;\n    border: 1px solid var(--accent-gold);\n    color: var(--accent-gold);\n    font-size: 12px; font-weight: 400; letter-spacing: 0.14em;\n    text-transform: uppercase; text-decoration: none;\n    transition: background 0.25s, color 0.25s;\n  }\n  .cta-btn:hover { background: var(--accent-gold); color: #0D0A14; }\n\n  /* ── AVAIO LOGO SVG ─────────────────────────── */\n  .avaio-logo-hero {\n    margin-bottom: 40px;\n    width: 220px; height: auto;\n    object-fit: contain;\n  }\n\n  /* ── SERVICES LIST ──────────────────────────── */\n  .services-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;\n    margin-top: 48px;\n  }\n  .service-card {\n    padding: 32px;\n    border: 1px solid var(--border);\n    background: var(--surface);\n    transition: background 0.5s, border-color 0.5s;\n  }\n  .service-card-num {\n    font-size: 11px; letter-spacing: 0.12em; color: var(--accent-gold); margin-bottom: 12px;\n  }\n  .service-card-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20px; font-weight: 400; color: var(--text-primary);\n    transition: color 0.5s;\n  }\n\n  /* ── SCROLL ANIMATIONS ──────────────────────── */\n  .reveal {\n    opacity: 0; transform: translateY(32px);\n    transition: opacity 0.7s ease, transform 0.7s ease;\n  }\n  .reveal.visible { opacity: 1; transform: translateY(0); }\n\n  /* ── DIRECTION TOGGLE (top left pill) ───────── */\n  .dir-toggle {\n    position: fixed; bottom: 32px; left: 32px; z-index: 200;\n    display: flex; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 4px; overflow: hidden; backdrop-filter: blur(12px);\n  }\n  .dir-btn {\n    padding: 10px 18px; font-size: 11px; letter-spacing: 0.1em;\n    text-transform: uppercase; cursor: pointer; border: none;\n    background: transparent; color: rgba(255,255,255,0.5);\n    font-family: 'DM Sans', sans-serif;\n    transition: background 0.2s, color 0.2s;\n  }\n  .dir-btn.active {\n    background: var(--accent-gold); color: #0D0A14;\n  }\n\n  /* ── DEVICE MOCKUPS ─────────────────────────── */\n  .device-mockup-section { background: #080610; padding: 80px; }\n  .device-stage {\n    display: flex; align-items: flex-start; gap: 48px;\n    justify-content: center; flex-wrap: wrap;\n  }\n\n  /* Desktop */\n  .desktop-mockup { flex: 0 1 100%; min-width: 0; max-width: 1000px; }\n  .browser-chrome {\n    background: #1E1B26; border-radius: 10px 10px 0 0;\n    padding: 10px 16px; display: flex; align-items: center; gap: 12px;\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n  }\n  .browser-dots { display: flex; gap: 6px; }\n  .browser-dots span { width: 10px; height: 10px; border-radius: 50%; display: block; }\n  .browser-bar { flex: 1; background: rgba(255,255,255,0.07); border-radius: 4px; padding: 4px 12px; }\n  .browser-url { font-size: 10px; color: rgba(255,255,255,0.4); letter-spacing: 0.04em; }\n  .browser-screen {\n    background: #100D1A; border-radius: 0 0 8px 8px;\n    overflow: hidden; border: 1px solid rgba(255,255,255,0.07); border-top: none;\n    font-family: 'DM Sans', sans-serif;\n  }\n  /* Site nav */\n  .site-nav {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 12px 24px; background: rgba(10,8,16,0.95);\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n  }\n  .site-nav-links { display: flex; gap: 20px; }\n  .site-nav-links span { font-size: 10px; color: rgba(255,255,255,0.55); letter-spacing: 0.04em; cursor: default; }\n  .site-cta-btn {\n    font-size: 9px; padding: 6px 14px; letter-spacing: 0.06em;\n    border: 1px solid rgba(201,168,108,0.5); color: #C9A86C; border-radius: 20px;\n    cursor: default;\n  }\n  /* Site hero */\n  .site-hero { position: relative; height: 260px; overflow: hidden; }\n  .site-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n  .site-hero-overlay {\n    position: absolute; inset: 0;\n    background: linear-gradient(to right, rgba(8,5,15,0.85) 50%, rgba(8,5,15,0.3));\n  }\n  .site-hero-content {\n    position: relative; z-index: 2; padding: 32px 28px;\n    display: flex; flex-direction: column; gap: 8px;\n  }\n  .site-eyebrow { font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A86C; }\n  .site-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 300; color: #F0EBE3; line-height: 1.15; }\n  .site-hero-sub { font-size: 9px; line-height: 1.6; color: rgba(240,235,227,0.6); max-width: 300px; }\n  .site-hero-btns { display: flex; gap: 10px; margin-top: 6px; }\n  .site-btn-outline {\n    font-size: 8px; padding: 5px 12px; letter-spacing: 0.06em;\n    border: 1px solid rgba(240,235,227,0.4); color: rgba(240,235,227,0.7);\n    border-radius: 20px; cursor: default;\n  }\n  .site-btn-gold {\n    font-size: 8px; padding: 5px 12px; letter-spacing: 0.06em;\n    background: rgba(201,168,108,0.15); border: 1px solid rgba(201,168,108,0.5);\n    color: #C9A86C; border-radius: 20px; cursor: default;\n  }\n  /* Campuses */\n  .site-campuses { padding: 24px 24px 0; background: #0D0A18; }\n  .site-section-label { font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: #C9A86C; margin-bottom: 4px; }\n  .site-section-sub { font-size: 9px; color: rgba(255,255,255,0.45); margin-bottom: 16px; line-height: 1.5; }\n  .site-campus-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; }\n  .site-campus-card { overflow: hidden; border-radius: 4px; background: #1A1428; }\n  .site-campus-card img { width: 100%; aspect-ratio: 3/2; object-fit: cover; display: block; }\n  .campus-info { padding: 8px; }\n  .campus-name { font-size: 8px; color: rgba(255,255,255,0.75); margin-bottom: 2px; }\n  .campus-mw { font-family: 'Cormorant Garamond', serif; font-size: 13px; color: #C9A86C; }\n  /* Stats */\n  .site-stats {\n    display: grid; grid-template-columns: repeat(4,1fr);\n    background: #080612; border-top: 1px solid rgba(255,255,255,0.06);\n    margin-top: 16px;\n  }\n  .stat-item { padding: 16px 20px; border-right: 1px solid rgba(255,255,255,0.06); }\n  .stat-item:last-child { border-right: none; }\n  .stat-num { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: #F0EBE3; }\n  .stat-lab { font-size: 8px; letter-spacing: 0.08em; color: rgba(255,255,255,0.35); margin-top: 2px; text-transform: uppercase; }\n\n  /* Mobile */\n  .mobile-mockup { flex: 0 0 220px; }\n  .phone-body {\n    background: #1A1428;\n    border-radius: 36px;\n    padding: 12px;\n    box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 24px 64px rgba(0,0,0,0.7);\n    position: relative;\n  }\n  .phone-notch {\n    width: 80px; height: 24px; background: #1A1428;\n    border-radius: 0 0 16px 16px; margin: 0 auto 8px;\n    position: relative; z-index: 2;\n  }\n  .phone-screen {\n    background: #100D1A; border-radius: 24px;\n    overflow: hidden; height: 480px;\n    overflow-y: auto; scrollbar-width: none;\n  }\n  .phone-screen::-webkit-scrollbar { display: none; }\n  .phone-home-bar {\n    width: 80px; height: 4px; background: rgba(255,255,255,0.3);\n    border-radius: 2px; margin: 10px auto 0;\n  }\n  /* Mobile nav */\n  .m-nav {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 10px 14px; background: rgba(10,8,16,0.95);\n    position: sticky; top: 0; z-index: 10;\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n  }\n  .m-hamburger { display: flex; flex-direction: column; gap: 3px; cursor: default; }\n  .m-hamburger span { display: block; width: 16px; height: 1.5px; background: rgba(255,255,255,0.6); border-radius: 1px; }\n  /* Mobile hero */\n  .m-hero { position: relative; height: 220px; overflow: hidden; }\n  .m-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n  .m-hero-overlay {\n    position: absolute; inset: 0;\n    background: linear-gradient(to bottom, rgba(8,5,15,0.4), rgba(8,5,15,0.85));\n  }\n  .m-hero-content {\n    position: relative; z-index: 2; padding: 20px 16px;\n    display: flex; flex-direction: column; gap: 6px;\n    height: 100%; justify-content: flex-end;\n  }\n  .m-eyebrow { font-size: 7px; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A86C; }\n  .m-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 300; color: #F0EBE3; line-height: 1.1; }\n  .m-hero-sub { font-size: 8px; line-height: 1.5; color: rgba(240,235,227,0.6); }\n  .m-btn {\n    display: inline-block; font-size: 7px; padding: 5px 12px; letter-spacing: 0.08em;\n    border: 1px solid rgba(201,168,108,0.5); color: #C9A86C; border-radius: 20px;\n    margin-top: 4px; cursor: default; align-self: flex-start;\n  }\n  /* Mobile campuses */\n  .m-campuses { padding: 16px; background: #0D0A18; }\n  .m-section-label { font-size: 8px; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A86C; margin-bottom: 10px; }\n  .m-campus-card { overflow: hidden; border-radius: 6px; margin-bottom: 8px; background: #1A1428; }\n  .m-campus-card img { width: 100%; aspect-ratio: 16/7; object-fit: cover; display: block; }\n  .m-campus-info { display: flex; justify-content: space-between; padding: 8px 10px; font-size: 9px; color: rgba(255,255,255,0.7); }\n  .m-stats-row { display: flex; gap: 8px; margin-top: 12px; }\n  .m-stats-row > div { flex: 1; background: rgba(255,255,255,0.04); border-radius: 6px; padding: 12px; text-align: center; }\n  .m-stat-num { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: #C9A86C; }\n  .m-stat-lab { font-size: 8px; color: rgba(255,255,255,0.4); margin-top: 2px; }\n\n  /* ── RESPONSIVE ────────────────────────────── */\n  @media (max-width: 1024px) {\n    .hero { padding: 100px 48px 60px; }\n    .meta-bar, .section, .mesh-panel, .footer-cta { padding-left: 48px; padding-right: 48px; }\n    .meta-grid { grid-template-columns: repeat(2,1fr); }\n    .meta-item:nth-child(odd) { padding-left: 0; }\n    .meta-item:nth-child(even) { border-right: none; padding-left: 32px; }\n    .meta-item:nth-child(3), .meta-item:nth-child(4) { border-top: 1px solid var(--rule); }\n    .two-col, .split-section, .result-blocks { grid-template-columns: 1fr; }\n    .split-img { min-height: 320px; }\n    .split-text { padding: 48px; }\n    .closing-strip { grid-template-columns: 1fr; }\n    .closing-img { aspect-ratio: 16/9; }\n    .services-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 640px) {\n    .hero { padding: 90px 24px 48px; }\n    .meta-bar, .section, .mesh-panel, .footer-cta { padding-left: 24px; padding-right: 24px; }\n    nav { padding: 16px 24px; }\n    .meta-grid { grid-template-columns: 1fr 1fr; }\n    .img-half-grid { grid-template-columns: 1fr; }\n    .services-grid { grid-template-columns: 1fr; }\n    .result-blocks { grid-template-columns: 1fr; }\n    .phase-item { grid-template-columns: 48px 1fr; gap: 16px; }\n    .phase-num { font-size: 36px; }\n    .hero-scroll { display: none; }\n    .dir-toggle { bottom: 16px; left: 16px; }\n  }\n<\u002Fstyle>\n<\u002Fhead>\n<body class=\"dark\">\n\n\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"hero-bg\">\n    <img src=\"205415d5-3025-4576-97a8-32826f0a0b20\" alt=\"AVAIO brand gradient background\">\n  <\u002Fdiv>\n  <div class=\"hero-overlay\"><\u002Fdiv>\n\n  <div class=\"hero-content\">\n\n\n    <div class=\"hero-eyebrow\">\n      <span class=\"tag\">Brand Identity<\u002Fspan>\n      <span class=\"tag\">Strategy<\u002Fspan>\n      <span class=\"tag\">Website<\u002Fspan>\n    <\u002Fdiv>\n\n    <h1 class=\"hero-title\">\n      Redefining a developer's<br>brand for <em>hyperscalers<\u002Fem>,<br>investors &amp; communities\n    <\u002Fh1>\n    <p class=\"hero-subtitle\">AVAIO Digital needed to look as credible as it was. We rebuilt the brand—from strategy to visual identity to a new Webflow site—and gave the team a story worth telling.<\u002Fp>\n  <\u002Fdiv>\n\n  <div class=\"hero-scroll\">\n    <div class=\"scroll-line\"><\u002Fdiv>\n    <span>Scroll<\u002Fspan>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- META BAR -->\n<div class=\"meta-bar\">\n  <div class=\"meta-grid\">\n    <div class=\"meta-item\">\n      <div class=\"meta-label\">Client<\u002Fdiv>\n      <div class=\"meta-value\">AVAIO Digital<\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"meta-item\">\n      <div class=\"meta-label\">Industry<\u002Fdiv>\n      <div class=\"meta-value\">Data Centers / Infrastructure<\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"meta-item\">\n      <div class=\"meta-label\">Scope<\u002Fdiv>\n      <div class=\"meta-value\">Brand · Strategy · Identity · Web<\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"meta-item\">\n      <div class=\"meta-label\">Impact<\u002Fdiv>\n      <div class=\"meta-value\">Traffic &amp; engagement up significantly<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<!-- SITUATION -->\n<section class=\"section reveal\" id=\"situation\">\n  <div class=\"section-inner two-col\">\n    <div class=\"two-col-text\">\n      <span class=\"section-label\">The Situation<\u002Fspan>\n      <h2 class=\"section-title\">A serious team with a<br><em>startup problem<\u002Fem><\u002Fh2>\n      <p class=\"body-text\">AVAIO Digital is a lean, highly experienced private equity–backed developer of hyperscale data center campuses across North America and Europe. The team was actively advancing major campuses—seasoned experts in finance, engineering, and energy—making real progress on significant developments.<\u002Fp>\n      <p class=\"body-text\">The problem: their brand and website didn't reflect any of that. A rushed identity blended into a crowded field. Poor mobile experience, broken project details, and an overall impression more startup than operator. Meanwhile, more eyes were landing on AVAIO every day—hyperscalers evaluating sites, investors doing diligence, communities researching campuses.<\u002Fp>\n    <\u002Fdiv>\n    <div>\n      <ul class=\"pain-list\">\n        <li class=\"pain-item\">\n          <div class=\"pain-dash\"><\u002Fdiv>\n          <p class=\"pain-text\">A vanilla, forgettable brand aesthetic that blended into the competitive landscape<\u002Fp>\n        <\u002Fli>\n        <li class=\"pain-item\">\n          <div class=\"pain-dash\"><\u002Fdiv>\n          <p class=\"pain-text\">Poor user experience, especially on mobile where many initial visits occur<\u002Fp>\n        <\u002Fli>\n        <li class=\"pain-item\">\n          <div class=\"pain-dash\"><\u002Fdiv>\n          <p class=\"pain-text\">Campus and project details that were hard to find or broken, undermining credibility<\u002Fp>\n        <\u002Fli>\n        <li class=\"pain-item\">\n          <div class=\"pain-dash\"><\u002Fdiv>\n          <p class=\"pain-text\">An overall impression of a startup still figuring things out, rather than a disciplined, well-capitalised developer<\u002Fp>\n        <\u002Fli>\n      <\u002Ful>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- VIDEO – Brand reveal after situation -->\n<div class=\"reveal\" style=\"width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;\">\n  <video src=\"a7228c37-39d5-48c9-9d2c-5cbdf756e77a\" autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fvideo>\n<\u002Fdiv>\n\n<!-- IMAGE FULL – Billboard render -->\n<div class=\"img-full reveal\">\n  <img src=\"69c57120-e6f8-4b22-81cb-a17f8c341071\" alt=\"AVAIO brand in context — billboard OOH advertising\">\n<\u002Fdiv>\n<p class=\"img-caption\" style=\"padding: 12px 80px 0;\">Brand in context — out-of-home advertising system<\u002Fp>\n\n<!-- OBJECTIVES MESH PANEL -->\n<div class=\"mesh-panel reveal\">\n  <div class=\"mesh-panel-bg\">\n    <img src=\"42ed3dde-d700-48ac-8df8-8359bdba7c9f\" alt=\"AVAIO gradient mesh\">\n  <\u002Fdiv>\n  <div class=\"mesh-overlay\"><\u002Fdiv>\n  <div class=\"mesh-content\">\n    <p class=\"mesh-quote\">\"The external story needed to catch up to the agility of the team and their real, emphasis on real, pipeline.\"<\u002Fp>\n    <span class=\"mesh-attr\">Aurient · Engagement Brief · AVAIO Digital<\u002Fspan>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<!-- OBJECTIVES -->\n<section class=\"section section-alt reveal\">\n  <div class=\"section-inner\">\n    <span class=\"section-label\">Objectives<\u002Fspan>\n    <h2 class=\"section-title\">What we set out<br>to <em>achieve<\u002Fem><\u002Fh2>\n    <div class=\"services-grid\">\n      <div class=\"service-card\">\n        <div class=\"service-card-num\">01<\u002Fdiv>\n        <div class=\"service-card-title\">Elevate Positioning<\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"service-card\">\n        <div class=\"service-card-num\">02<\u002Fdiv>\n        <div class=\"service-card-title\">Reflect Real Expertise<\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"service-card\">\n        <div class=\"service-card-num\">03<\u002Fdiv>\n        <div class=\"service-card-title\">Differentiate from Peers<\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"service-card\">\n        <div class=\"service-card-num\">04<\u002Fdiv>\n        <div class=\"service-card-title\">Clarify Audience Narratives<\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"service-card\">\n        <div class=\"service-card-num\">05<\u002Fdiv>\n        <div class=\"service-card-title\">Modern Mobile-First Site<\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"service-card\">\n        <div class=\"service-card-num\">06<\u002Fdiv>\n        <div class=\"service-card-title\">Improve Lead Capture<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- WHAT WE DID -->\n<section class=\"section reveal\">\n  <div class=\"section-inner\">\n    <span class=\"section-label\">What We Did<\u002Fspan>\n    <h2 class=\"section-title\">Five phases, one<br><em>coherent system<\u002Fem><\u002Fh2>\n    <p class=\"body-text\">We rebuilt the brand from the inside out—starting with deep discovery and competitive research, and ending with a live Webflow site that gives AVAIO room to grow without bottlenecks.<\u002Fp>\n\n    <div class=\"phases\">\n      <div class=\"phase-item\">\n        <div class=\"phase-num\">01<\u002Fdiv>\n        <div class=\"phase-body\">\n          <div class=\"phase-title\">Competitive Research &amp; Personas<\u002Fdiv>\n          <p class=\"phase-text\">We benchmarked leading data center developers, mapped the visual and verbal tropes in the category, and identified real whitespace. Then we built personas for the three audiences most likely to interact with AVAIO—hyperscaler site selection teams, institutional investors, and local community officials—which became a filter for every subsequent decision.<\u002Fp>\n          <div class=\"phase-tags\">\n            <span class=\"phase-tag\">Competitive analysis<\u002Fspan>\n            <span class=\"phase-tag\">Persona development<\u002Fspan>\n            <span class=\"phase-tag\">Category mapping<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div class=\"phase-item\">\n        <div class=\"phase-num\">02<\u002Fdiv>\n        <div class=\"phase-body\">\n          <div class=\"phase-title\">Brand Strategy &amp; Positioning<\u002Fdiv>\n          <p class=\"phase-text\">Through in-depth interviews with leadership across finance, engineering, energy, and development, we uncovered what was genuinely different about AVAIO. We built a comprehensive brand platform: mission, vision, purpose, positioning, values, and audience-specific value propositions. The strategy moved AVAIO from \"another new developer\" to a trusted, credible, and sharp operator.<\u002Fp>\n          <div class=\"phase-tags\">\n            <span class=\"phase-tag\">Brand platform<\u002Fspan>\n            <span class=\"phase-tag\">Positioning<\u002Fspan>\n            <span class=\"phase-tag\">Messaging<\u002Fspan>\n            <span class=\"phase-tag\">Value propositions<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div class=\"phase-item\">\n        <div class=\"phase-num\">03<\u002Fdiv>\n        <div class=\"phase-body\">\n          <div class=\"phase-title\">Visual Identity &amp; Design System<\u002Fdiv>\n          <p class=\"phase-text\">With strategy in place, we translated it into a visual system that signals maturity and technical confidence. A new logo and mark designed to flex across digital, print, and site signage. A supporting system of typography, colour, and layout patterns suitable for institutional and technical audiences—modern and distinctive without being trendy or over-designed.<\u002Fp>\n          <div class=\"phase-tags\">\n            <span class=\"phase-tag\">Logo &amp; mark<\u002Fspan>\n            <span class=\"phase-tag\">Typography<\u002Fspan>\n            <span class=\"phase-tag\">Colour system<\u002Fspan>\n            <span class=\"phase-tag\">Collateral<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div class=\"phase-item\">\n        <div class=\"phase-num\">04<\u002Fdiv>\n        <div class=\"phase-body\">\n          <div class=\"phase-title\">Website Architecture, Content &amp; UX<\u002Fdiv>\n          <p class=\"phase-text\">We rethought the digital presence from the ground up—content outline, sitemap, base copy tuned for each audience, and UX design concepts that resolved issues with campus visibility, mobile experience, and navigation. The website is now a credible extension of what stakeholders hear in meetings, instead of a liability.<\u002Fp>\n          <div class=\"phase-tags\">\n            <span class=\"phase-tag\">UX design<\u002Fspan>\n            <span class=\"phase-tag\">Content strategy<\u002Fspan>\n            <span class=\"phase-tag\">Copywriting<\u002Fspan>\n            <span class=\"phase-tag\">Information architecture<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div class=\"phase-item\">\n        <div class=\"phase-num\">05<\u002Fdiv>\n        <div class=\"phase-body\">\n          <div class=\"phase-title\">Webflow Development &amp; Lead Capture<\u002Fdiv>\n          <p class=\"phase-text\">The site was built on Webflow — giving AVAIO's team the ability to update content, add campuses, and avoid reliance on external developers. Improved lead capture on key pages means high-intent visitors can now contact AVAIO easily. Fully responsive, with special attention paid to mobile usability where many initial visits occur.<\u002Fp>\n          <div class=\"phase-tags\">\n            <span class=\"phase-tag\">Webflow development<\u002Fspan>\n            <span class=\"phase-tag\">CMS setup<\u002Fspan>\n            <span class=\"phase-tag\">Lead capture<\u002Fspan>\n            <span class=\"phase-tag\">Mobile optimisation<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- SPLIT: Stationery image + text -->\n<div class=\"split-section reveal\">\n  <div class=\"split-img\">\n    <img src=\"7c664515-d661-495a-8da2-799fb04b8ece\" alt=\"AVAIO brand system — stationery and collateral suite\">\n  <\u002Fdiv>\n  <div class=\"split-text\">\n    <span class=\"section-label\">Visual Identity<\u002Fspan>\n    <h3 class=\"section-title\" style=\"font-size: clamp(28px,3vw,42px);\">A system built to<br><em>scale with ambition<\u002Fem><\u002Fh3>\n    <p class=\"body-text\">The identity is flexible enough to carry AVAIO from a development-stage pitch to a fully operational campus—from investor decks to community town halls, letterhead to site signage.<\u002Fp>\n    <p class=\"body-text\">The Aquilla constellation in the logo mark connects with the immense responsibility of AVAIO as the facilitators of innovation and societal progress. The tagline of \"Constellations of Capacity\" has multiple meanings, but leans into nodes of capacity connected across a network, scalable by design.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<!-- VIDEO – Brand in motion -->\n<div class=\"reveal\" style=\"width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;\">\n  <video src=\"a7228c37-39d5-48c9-9d2c-5cbdf756e77a\" autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fvideo>\n<\u002Fdiv>\n\n<!-- WEBSITE SECTION -->\n<section class=\"section section-alt reveal\">\n  <div class=\"section-inner\">\n    <span class=\"section-label\">Website<\u002Fspan>\n    <h2 class=\"section-title\">A digital presence that<br>opens <em>doors<\u002Fem><\u002Fh2>\n    <p class=\"body-text\">The previous site was a liability. The new one is a credible, modern platform that stakeholders actively want to share — structured so visitors can quickly understand where AVAIO is active, what's being built, and what makes a given campus different.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- DEVICE MOCKUPS -->\n<div class=\"reveal device-mockup-section\">\n  <div class=\"device-stage\">\n\n    <!-- DESKTOP BROWSER MOCKUP -->\n    <div class=\"desktop-mockup\">\n      <div class=\"browser-chrome\">\n        <div class=\"browser-dots\">\n          <span style=\"background:#FF5F57\"><\u002Fspan>\n          <span style=\"background:#FEBC2E\"><\u002Fspan>\n          <span style=\"background:#28C840\"><\u002Fspan>\n        <\u002Fdiv>\n        <div class=\"browser-bar\">\n          <div class=\"browser-url\">avaiodigital.com<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"browser-screen\">\n        <!-- Recreated AVAIO homepage -->\n        <div class=\"site-nav\">\n          <img src=\"6889b28e-7782-4aa0-b648-f3749410b548\" alt=\"AVAIO\" style=\"height:18px;width:auto;object-fit:contain;\">\n          <div class=\"site-nav-links\">\n            <span>About Us<\u002Fspan><span>Solutions<\u002Fspan><span>Campus Sites<\u002Fspan><span>News<\u002Fspan>\n          <\u002Fdiv>\n          <div class=\"site-cta-btn\">Let's Talk Capacity<\u002Fdiv>\n        <\u002Fdiv>\n        <div class=\"site-hero\">\n          <img src=\"0a2797ea-5ec0-4831-9af4-73878c383805\" alt=\"Server farm\" class=\"site-hero-bg\">\n          <div class=\"site-hero-overlay\"><\u002Fdiv>\n          <div class=\"site-hero-content\">\n            <div class=\"site-eyebrow\">WELCOME<\u002Fdiv>\n            <h2 class=\"site-hero-title\">Constellations<br>of Capacity<\u002Fh2>\n            <p class=\"site-hero-sub\">We deliver certainty at scale. AVAIO is building a multi-campus data center portfolio with 400MW of secured power coming online in 2027.<\u002Fp>\n            <div class=\"site-hero-btns\">\n              <div class=\"site-btn-outline\">Meet the Team<\u002Fdiv>\n              <div class=\"site-btn-gold\">Let's Talk Capacity<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div class=\"site-campuses\">\n          <div class=\"site-section-label\">Sites &amp; Locations<\u002Fdiv>\n          <p class=\"site-section-sub\">Ready-to-build, fully secured campuses in key US markets<\u002Fp>\n          <div class=\"site-campus-grid\">\n            <div class=\"site-campus-card\">\n              <img src=\"b41a0eab-76d5-499e-8861-06ba5544b736\" alt=\"Little Rock\">\n              <div class=\"campus-info\">\n                <div class=\"campus-name\">Little Rock, AR<\u002Fdiv>\n                <div class=\"campus-mw\">1,070 MW<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div class=\"site-campus-card\">\n              <img src=\"8d6afc90-3973-4ff6-940e-692a32047362\" alt=\"Bra